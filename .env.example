# URL pública, sin slash final. En Vercel se detecta automáticamente si se omite.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Canales comerciales (sin @ y WhatsApp con código de país, sólo números).
NEXT_PUBLIC_INSTAGRAM_USERNAME=tu_usuario
NEXT_PUBLIC_WHATSAPP_NUMBER=56912345678

# Credencial privada de Mercado Pago: jamás uses el prefijo NEXT_PUBLIC_.
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Catálogo, autenticación administrativa e imágenes.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# Sólo servidor: permite crear pedidos y confirmar pagos. Nunca uses NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional hasta activar Mercado Pago Webhooks desde Tus integraciones.
MERCADOPAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Integración logística futura (Shipit requiere crear una cuenta comercial).
SHIPIT_EMAIL=correo@ejemplo.cl
SHIPIT_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
