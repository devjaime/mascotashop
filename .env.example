# URL pública, sin slash final. En Vercel se detecta automáticamente si se omite.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Canales comerciales (sin @ y WhatsApp con código de país, sólo números).
NEXT_PUBLIC_INSTAGRAM_USERNAME=tu_usuario
NEXT_PUBLIC_WHATSAPP_NUMBER=56912345678

# Credencial privada de Mercado Pago: jamás uses el prefijo NEXT_PUBLIC_.
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Catálogo, autenticación administrativa e imágenes.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx
